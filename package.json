{
  "name": "automationexercise-qa",
  "version": "1.0.0",
  "private": true,
  "description": "API and E2E test automation for https://automationexercise.com using Playwright and TypeScript",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=e2e --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "keywords": [
    "playwright",
    "typescript",
    "qa",
    "api-testing",
    "e2e"
  ],
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "dotenv": "^18.0.9",
    "typescript": "^5.9.0"
  }
}
